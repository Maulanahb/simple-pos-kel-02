meta {
  name: 01 - Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "kasir@pos.test",
    "password": "password"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar('token', res.body.token);
  }
}
